    };
    const baseJogadores=['Goleiro','Lateral direito','Zagueiro','Zagueiro','Lateral esquerdo','Volante','Meia','Meia','Ponta direita','Centroavante','Ponta esquerda'];
    function elencoDoClube(nome){ const elenco=elencosDisponiveis[nome] || baseJogadores.map((posicao,index)=>[`Jogador não informado ${index+1}`,posicao]); return elenco.map((jogador,index)=>({nome:jogador[0],posicao:jogador[1],numero:index+1,jogos:'Não informado',titular:'Não informado',minutos:'Não informado',gols:'Não informado',assistencias:'Não informado',passes:'Não informado',desarmes:'Não informado',defesas:'Não informado',cartoes:'Não informado'})); }
    let elencoAtual=[];
    function cartaoJogador(jogador,index){ return `<button class="jogador" onclick="mostrarEstatisticasJogador(${index})" aria-label="Ver dados de ${jogador.nome}"><span class="numero">${jogador.numero}</span>${jogador.nome}<span class="posicao">${jogador.posicao}</span></button>`; }
    function abrirEscalacao(nome){ elencoAtual=elencoDoClube(nome); const clube=clubePorNome[nome]; document.getElementById('conteudo').innerHTML=`<div class="acoes-pagina"><button class="voltar" onclick="mostrarNoticiasDoClube('${nome}')">← Voltar às notícias</button></div><div class="escalacao-cabecalho">${escudo(clube)}<div><h2>Jogadores do ${nome}</h2><p>Nomes e posições disponíveis. Clique em um jogador para consultar os dados cadastrados.</p></div></div><section class="campo" aria-label="Campo com jogadores do clube">${elencoAtual.slice(0,11).map(cartaoJogador).join('')}</section>${elencoAtual.length > 11 ? `<h3 class="reservas-titulo">Jogadores reservas</h3><section class="reservas" aria-label="Jogadores reservas">${elencoAtual.slice(11).map((j,index)=>cartaoJogador(j,index+11)).join('')}</section>` : ''}`; window.scrollTo({top:0,behavior:'smooth'}); }
    function mostrarEstatisticasJogador(indice){ const j=elencoAtual[indice]; const dados=[['Jogos',j.jogos],['Como titular',j.titular],['Minutos',j.minutos],['Gols',j.gols],['Assistências',j.assistencias],['Passes certos',j.passes],['Desarmes',j.desarmes],['Defesas',j.defesas],['Cartões',j.cartoes]]; document.body.insertAdjacentHTML('beforeend',`<div class="modal-estatisticas" id="modal-estatisticas" role="dialog" aria-modal="true" aria-label="Dados de ${j.nome}"><section class="painel-estatisticas"><button class="fechar-modal" onclick="fecharEstatisticas()" aria-label="Fechar">×</button><div class="noticia-clube">${j.posicao}</div><h2>${j.nome}</h2><p>Dados individuais não informados pela fonte disponível.</p><div class="grade-estatisticas">${dados.map(d=>`<div class="estatistica"><strong>${d[1]}</strong><span>${d[0]}</span></div>`).join('')}</div></section></div>`); }
    function fecharEstatisticas(){ document.getElementById('modal-estatisticas')?.remove(); }
    const classificacao=[['Flamengo',80,36,24,8,4,74,31,43,[], 'liberta'],['Palmeiras',74,36,21,11,4,64,26,38,[], 'liberta'],['Cruzeiro',63,35,19,6,10,57,49,8,[], 'liberta'],['Fluminense',60,35,17,9,9,56,42,14,[], 'liberta'],['Athletico-PR',54,35,15,9,11,52,45,7,[], 'liberta'],['Bahia',54,36,14,12,10,50,46,4,[], 'preliberta'],['Atlético-MG',51,35,14,9,12,44,40,4,[], 'sula'],['Santos',50,35,13,11,11,51,49,2,[], 'sula'],['Bragantino',47,35,13,8,14,45,41,4,[], 'sula'],['Vasco da Gama',47,35,13,8,14,47,51,-4,[], 'sula'],['Coritiba',45,36,12,9,15,41,52,-11,[], 'sula'],['São Paulo',44,35,12,8,15,39,40,-1,[], ''],['Botafogo',42,35,11,9,15,46,57,-11,[], ''],['Vitória',41,35,11,8,16,37,52,-15,[], ''],['Mirassol',41,35,10,11,14,39,48,-9,[], ''],['Corinthians',40,35,10,10,15,40,42,-2,[], ''],['Internacional',38,35,9,11,15,39,44,-5,[], 'rebaixado'],['Grêmio',38,35,9,11,15,38,47,-9,[], 'rebaixado'],['Remo',32,35,7,11,17,39,57,-18,[], 'rebaixado'],['Chapecoense',21,35,4,9,22,33,72,-39,[], 'rebaixado']];
    function tabela(){ return `<h2>Tabela atualizada</h2><p class="simulador-intro">Classificação informada em 21/11/2026. Flamengo, Palmeiras, Bahia e Coritiba têm 36 jogos; os demais, 35.</p><div class="tabela-card"><table><thead><tr><th>Pos</th><th>Time</th><th>Pts</th><th>PJ</th><th>Vit</th><th>E</th><th>Der</th><th>GM</th><th>GC</th><th>SG</th><th>Últimas 5</th></tr></thead><tbody>${classificacao.map((t,i)=>`<tr class="${t[10]}"><td>${i+1}</td><td><div class="time-cell">${escudo(clubePorNome[t[0]],true)}${t[0]}</div></td><td><strong>${t[1]}</strong></td><td>${t[2]}</td><td>${t[3]}</td><td>${t[4]}</td><td>${t[5]}</td><td>${t[6]}</td><td>${t[7]}</td><td>${t[8]}</td><td>${forma(t[9])}</td></tr>`).join('')}</tbody></table><div class="legenda"><span class="item-legenda"><i class="cor" style="background:#20d879"></i>Libertadores</span><span class="item-legenda"><i class="cor" style="background:#ffd33d"></i>Pré-Libertadores</span><span class="item-legenda"><i class="cor" style="background:#31bbf5"></i>Sul-Americana</span><span class="item-legenda"><i class="cor" style="background:#ef4a60"></i>Rebaixamento</span></div></div>`; }
    const partidasFinais=[
      [36,'Palmeiras','Flamengo','21/11 · 16h30','Nubank Parque',[1,1]],[36,'Bahia','Coritiba','21/11 · 17h30','A definir',[0,1]],[36,'Chapecoense','Cruzeiro','21/11 · 21h','Arena Condá',[1,2]],[36,'Internacional','Vitória','23/11 · 19h30','A definir'],[36,'Botafogo','São Paulo','23/11 · 20h','Nilton Santos'],[36,'Santos','Grêmio','23/11 · 21h','MorumBIS'],[36,'Fluminense','Mirassol','A definir','A definir'],[36,'Bragantino','Vasco da Gama','A definir','A definir'],[36,'Atlético-MG','Corinthians','25/11 · 20h','Arena MRV'],[36,'Athletico-PR','Remo','A definir','A definir',[4,1]],
      [37,'Chapecoense','Palmeiras','24/11 · 18h','Arena Condá'],[37,'São Paulo','Remo','26/11 · 20h','Morumbis'],[37,'Fluminense','Cruzeiro','27/11 · 20h','Maracanã'],[37,'Botafogo','Bahia','28/11 · 21h','Nilton Santos'],[37,'Coritiba','Flamengo','29/11 · 16h','Couto Pereira'],[37,'Vitória','Santos','29/11 · 16h','Barradão'],[37,'Corinthians','Grêmio','29/11 · 18h30','Neo Química Arena'],[37,'Mirassol','Athletico-PR','29/11 · 18h30','Maião'],[37,'Internacional','Bragantino','29/11 · 18h30','Beira-Rio'],[37,'Atlético-MG','Vasco da Gama','29/11 · 19h30','Arena MRV'],
      [38,'Flamengo','Chapecoense','02/12 · 21h30','Maracanã'],[38,'Vasco da Gama','Vitória','02/12 · 21h30','São Januário'],[38,'Santos','Botafogo','02/12 · 21h30','Vila Belmiro'],[38,'Palmeiras','Coritiba','02/12 · 21h30','Nubank Parque'],[38,'Bragantino','Fluminense','02/12 · 21h30','Cícero de Souza Marques'],[38,'Cruzeiro','Internacional','02/12 · 21h30','Mineirão'],[38,'Grêmio','Mirassol','02/12 · 21h30','Arena do Grêmio'],[38,'Athletico-PR','São Paulo','02/12 · 21h30','Arena da Baixada'],[38,'Bahia','Atlético-MG','02/12 · 21h30','Arena Fonte Nova'],[38,'Remo','Corinthians','02/12 · 21h30','Mangueirão']
    ];
    const partidasPorRodada=partidasFinais.reduce((grupos,partida)=>{(grupos[partida[0]]??=[]).push(partida);return grupos},{});
    function jogos(){ const partida=(jogo)=>`<article class="partida"><div class="partida-time">${escudo(clubePorNome[jogo[1]],true)}<span>${jogo[1]}</span></div><div class="partida-placar">${jogo[5]?`${jogo[5][0]} × ${jogo[5][1]}`:'×'}<small>${jogo[3]} · ${jogo[4]}${jogo[5]?' · Encerrado':''}</small></div><div class="partida-time visitante"><span>${jogo[2]}</span>${escudo(clubePorNome[jogo[2]],true)}</div></article>`; return `<h2>Jogos do Brasileirão</h2><p class="simulador-intro">As três últimas rodadas do Brasileirão 2026 · horários de Brasília · “A definir” indica informação ainda não cadastrada.</p><section class="rodadas-lista">${Object.entries(partidasPorRodada).map(([rodada,lista])=>`<article class="tabela-card rodada-card"><header class="rodada-cabecalho"><h3>${rodada}ª rodada</h3><span>${lista.length} jogos</span></header>${lista.map(partida).join('')}</article>`).join('')}</section>`; }
    const jogosSimulador=partidasFinais;
    let resultadosSimulador=(()=>{try{return JSON.parse(localStorage.getItem('simuladorBrasileirao'))||{}}catch(e){return{}}})();
    function classificacaoSimulada(){
      const tabelaAtual=classificacao.map(time=>[...time]);
      jogosSimulador.forEach((jogo,indice)=>{ const oficial=jogo[5], incluirOficial=oficial && (jogo[1]==='Chapecoense' || jogo[1]==='Athletico-PR'), resultado=incluirOficial?oficial:resultadosSimulador[indice]; if(!resultado || resultado[0]==='' || resultado[1]==='') return; const golsCasa=+resultado[0], golsVisitante=+resultado[1], casa=tabelaAtual.find(time=>time[0]===jogo[1]), visitante=tabelaAtual.find(time=>time[0]===jogo[2]); casa[2]++; visitante[2]++; casa[6]+=golsCasa;casa[7]+=golsVisitante;visitante[6]+=golsVisitante;visitante[7]+=golsCasa;casa[8]=casa[6]-casa[7];visitante[8]=visitante[6]-visitante[7]; if(golsCasa>golsVisitante){casa[1]+=3;casa[3]++;visitante[5]++;} else if(golsVisitante>golsCasa){visitante[1]+=3;visitante[3]++;casa[5]++;} else {casa[1]++;visitante[1]++;casa[4]++;visitante[4]++;} });
      return tabelaAtual.sort((a,b)=>b[1]-a[1] || b[3]-a[3] || b[8]-a[8] || b[6]-a[6] || a[0].localeCompare(b[0],'pt-BR'));
    }
    function tabelaSimulada(){ const tabelaAtual=classificacaoSimulada(); return `<div class="tabela-card"><div class="tabela-simulada-cabecalho"><h3>Classificação projetada</h3><span>${Object.keys(resultadosSimulador).length} resultado(s) definido(s)</span></div><table><thead><tr><th>Pos</th><th>Time</th><th>Pts</th><th>PJ</th><th>Vit</th><th>E</th><th>Der</th><th>SG</th></tr></thead><tbody>${tabelaAtual.map((time,indice)=>`<tr class="${time[10]}"><td>${indice+1}</td><td><div class="time-cell">${escudo(clubePorNome[time[0]],true)}${time[0]}</div></td><td><strong>${time[1]}</strong></td><td>${time[2]}</td><td>${time[3]}</td><td>${time[4]}</td><td>${time[5]}</td><td>${time[8]}</td></tr>`).join('')}</tbody></table></div>`; }
    function atualizarSimulacao(indice,lado,valor){ const placar=resultadosSimulador[indice]||['','']; placar[lado]=String(valor).replace(/\D/g,'').slice(0,2); if(placar[0]===''&&placar[1]==='') delete resultadosSimulador[indice]; else resultadosSimulador[indice]=placar; try{localStorage.setItem('simuladorBrasileirao',JSON.stringify(resultadosSimulador))}catch(e){} document.getElementById('tabela-simulada').innerHTML=tabelaSimulada(); }
    function limparSimulacao(){ resultadosSimulador={}; try{localStorage.removeItem('simuladorBrasileirao')}catch(e){} document.getElementById('conteudo').innerHTML=simulador(); }
    function sortearSimulacao(){ const gols=()=>{const r=Math.random();return r<.28?0:r<.62?1:r<.84?2:r<.95?3:4}; resultadosSimulador=Object.fromEntries(jogosSimulador.flatMap((jogo,indice)=>jogo[5]?[]:[[indice,[String(gols()),String(gols())]]])); try{localStorage.setItem('simuladorBrasileirao',JSON.stringify(resultadosSimulador))}catch(e){} document.getElementById('conteudo').innerHTML=simulador(); }
    function simulador(){ const jogo=(times,indice)=>{const oficial=times[5], placar=oficial||resultadosSimulador[indice]||['',''], bloqueado=oficial?'disabled':'';return `<article class="jogo-simulador"><div class="time-simulador">${escudo(clubePorNome[times[1]],true)}<span>${times[1]}</span></div><div class="resultado-simulador" aria-label="Placar de ${times[1]} contra ${times[2]}"><input type="text" inputmode="numeric" maxlength="2" value="${placar[0]}" ${bloqueado} oninput="atualizarSimulacao(${indice},0,this.value)" aria-label="Gols de ${times[1]}"> <b>×</b> <input type="text" inputmode="numeric" maxlength="2" value="${placar[1]}" ${bloqueado} oninput="atualizarSimulacao(${indice},1,this.value)" aria-label="Gols de ${times[2]}"></div><div class="time-simulador visitante"><span>${times[2]}</span>${escudo(clubePorNome[times[2]],true)}</div></article>`}; return `<h2>Simulação do Brasileirão Série A 2026</h2><p class="simulador-intro">Parte da tabela de 21/11 e soma os placares que você digitar nas três últimas rodadas. Nada aqui altera a classificação oficial. Desempate: pontos, vitórias, saldo e gols pró.</p><section class="simulador-layout"><div class="simulador-jogos"><header class="simulador-jogos-cabecalho"><h3>Rodadas 36, 37 e 38</h3><p>Os placares encerrados ficam bloqueados; preencha os demais confrontos.</p></header>${jogosSimulador.map(jogo).join('')}<div class="simulador-acoes"><button class="sortear-simulacao" onclick="sortearSimulacao()">Sortear tudo</button><button class="limpar-simulacao" onclick="limparSimulacao()">Limpar simulações</button></div></div><aside class="tabela-simulada" id="tabela-simulada">${tabelaSimulada()}</aside></section>`; }
    function estatisticas(){
      const artilharia=[['Kevin Viveros','Athletico-PR',21],['Pedro','Flamengo',20],['Gabriel Barbosa','Santos',16],['Kaio Jorge','Cruzeiro',14],['Samuel Lino','Flamengo',13],['Carlos Vinícius','Grêmio',11],['Matheus Pereira','Cruzeiro',11],['Luciano Juba','Bahia',11],['Renê','Vitória',11],['José Manuel López','Palmeiras',10],['Maurício','Palmeiras',10],['Jonathan Calleri','São Paulo',10],['Jajá','Remo',10],['Danilo Santos','Botafogo',10],['Pedro Rocha','Coritiba',9]],
        assistencias=[['Andreas Pereira','Palmeiras',10],['Josué Pesqueira','Coritiba',10],['Samuel Lino','Flamengo',9],['Jorge Carrascal','Flamengo',9],['Erick','Vitória',7],['José Manuel López','Palmeiras',7],['Matheus Pereira','Cruzeiro',7],['Rodrigo Garro','Corinthians',7],['Keny Arroyo','Cruzeiro',7],['Guillermo Varela','Flamengo',7],['Giovanni Augusto','Chapecoense',7],['Pedro','Flamengo',6],['Igor Marques','Mirassol',5],['Alesson','Mirassol',5],['Luciano Acosta','Fluminense',5]],
        amarelos=[['Matheus Pereira','Cruzeiro',13],['Juninho Capixaba','Bragantino',13],['Rodrigo Garro','Corinthians',11],['Camilo','Chapecoense',11],['Nicolás Acevedo','Bahia',11],['Gabriel Mercado','Internacional',10],['Andrés Gómez','Vasco da Gama',10],['Neymar Jr','Santos',9],['Thiago Santos','Coritiba',9],['Álvaro Barreal','Santos',9],['Erick Pulgar','Flamengo',9],['Alexander Bernabei','Internacional',9],['Léo Pereira','Flamengo',9],['Alix Vinicius','Bragantino',8],['Gabriel Barbosa','Santos',8]],
        vermelhos=[['Alexander Barboza','Palmeiras',2],['André','Corinthians',2],['Fabinho','Bragantino',2],['Jorge Carrascal','Flamengo',2],['Jorginho','Flamengo',2],['Agustín Canobbio','Fluminense',1],['Alexander Bernabei','Internacional',1],['Alix Vinicius','Bragantino',1],['Allan Rodrigues','Corinthians',1],['Álvaro Barreal','Santos',1],['Andreas Pereira','Palmeiras',1],['Arthur Cabral','Botafogo',1],['Bruno Melo','Coritiba',1],['Bruno Zapelli','Athletico-PR',1],['Carlos Cuesta','Vasco da Gama',1]];
      const destaque=(titulo,dados,unidade,classe)=>`<article class="destaque-estatistica ${classe}"><small>${titulo}</small><strong>${dados[0][0]}</strong><span>${dados[0][1]} · <b>${dados[0][2]}</b> ${unidade}</span></article>`;
      const bloco=(titulo,lista,unidade,classe)=>`<section class="tabela-card ranking-card ${classe}" data-ranking="${classe}"><h3>${titulo}</h3><ol class="ranking-lista">${lista.map((x,i)=>`<li class="ranking-item" data-pesquisa="${x[0]} ${x[1]}"><span class="ranking-posicao">${i+1}</span><div class="ranking-jogador">${clubePorNome[x[1]]?escudo(clubePorNome[x[1]],true):''}<div><strong>${x[0]}</strong><span>${x[1]}</span></div></div><div class="ranking-numero">${x[2]}<small>${unidade}</small></div></li>`).join('')}</ol><p class="sem-resultados" hidden>Nenhum jogador encontrado.</p></section>`;
      return `<section class="estatisticas-cabecalho"><div><h2>Estatísticas dos jogadores</h2></div><p class="estatisticas-atualizacao">Rankings individuais do Brasileirão Série A 2026</p></section><div class="stat-tabs"><button class="ativo" onclick="selecionarRanking('todos',this)">Todos</button><button onclick="selecionarRanking('artilharia',this)">Artilharia</button><button onclick="selecionarRanking('assistencias',this)">Assistências</button><button onclick="selecionarRanking('cartoes-amarelos',this)">Amarelos</button><button onclick="selecionarRanking('cartoes-vermelhos',this)">Vermelhos</button></div><input class="busca-estatisticas" id="busca-estatisticas" placeholder="Buscar jogador ou clube..." oninput="filtrarRankings(this.value)"><section class="destaques-estatisticas" aria-label="Líderes das estatísticas">${destaque('Artilheiro',artilharia,'gols','artilharia')}${destaque('Líder de assistências',assistencias,'assistências','assistencias')}${destaque('Mais cartões amarelos',amarelos,'amarelos','amarelos')}${destaque('Mais cartões vermelhos',vermelhos,'vermelhos','vermelhos')}</section><section class="grid-estatisticas" id="rankings-estatisticas">${bloco('Artilharia',artilharia,'gols','artilharia')}${bloco('Assistências',assistencias,'assistências','assistencias')}${bloco('Cartões amarelos',amarelos,'amarelos','cartoes-amarelos')}${bloco('Cartões vermelhos',vermelhos,'vermelhos','cartoes-vermelhos')}</section>`;
    }
    function selecionarRanking(categoria,botao){ document.querySelectorAll('.stat-tabs button').forEach(botao=>botao.classList.remove('ativo')); botao.classList.add('ativo'); document.querySelectorAll('#rankings-estatisticas [data-ranking]').forEach(bloco=>bloco.hidden=categoria!=='todos'&&!bloco.classList.contains(categoria)); filtrarRankings(document.getElementById('busca-estatisticas')?.value||''); }
    function filtrarRankings(termo){ const busca=termo.toLocaleLowerCase('pt-BR'); document.querySelectorAll('#rankings-estatisticas [data-ranking]').forEach(bloco=>{let visiveis=0; bloco.querySelectorAll('.ranking-item').forEach(item=>{const mostrar=item.dataset.pesquisa.toLocaleLowerCase('pt-BR').includes(busca); item.hidden=!mostrar;if(mostrar)visiveis++}); bloco.querySelector('.sem-resultados').hidden=visiveis>0;}); }
    function mostrar(secao,botao){ const conteudo=document.getElementById('conteudo'), telas={noticias,times,meuClube,tabela,jogos,estatisticas,simulador}; conteudo.className=''; conteudo.style.removeProperty('--cor-clube'); conteudo.style.removeProperty('--cor-secundaria'); conteudo.innerHTML=telas[secao](); document.querySelectorAll('.menu button').forEach(b=>b.classList.remove('ativo')); if(botao) botao.classList.add('ativo'); window.scrollTo({top:0,behavior:'smooth'}); }
    mostrar('noticias',document.querySelector('.menu button'));
  </script>
</body>
</html>
