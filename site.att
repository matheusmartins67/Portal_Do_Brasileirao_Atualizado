      'São Paulo':['https://r2.thesportsdb.com/images/media/team/badge/sxpupx1473538135.png','https://r2.thesportsdb.com/images/media/team/fanart/yvuqqx1420407660.jpg'],
      'Santos':['https://r2.thesportsdb.com/images/media/team/badge/j8xk9g1679447486.png','https://r2.thesportsdb.com/images/media/team/fanart/15zz3u1749480159.jpg'],
