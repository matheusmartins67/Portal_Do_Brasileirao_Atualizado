<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal do Brasileirão</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root { --azul:#071d49; --azul-medio:#0b3d91; --verde:#20c36a; --amarelo:#ffd33d; --vermelho:#ee334e; --texto:#eaf1ff; --muted:#adbed9; --card:#102a5b; }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { min-height:100vh; background:radial-gradient(circle at 10% 0%, #1759ad 0, transparent 30%), linear-gradient(145deg,#061333 0%,#092760 50%,#071839 100%); color:var(--texto); font-family:Roboto,Arial,sans-serif; }
    .topo { padding:18px 24px; background:#071b3e; border-bottom:1px solid #ffffff24; box-shadow:0 4px 16px #0005; }
    .marca { max-width:1280px; margin:auto; display:flex; align-items:center; justify-content:center; gap:13px; }
    .logo-serie-a { width:48px; height:48px; object-fit:contain; filter:drop-shadow(0 3px 4px #0006); }
    .topo h1 { font:700 clamp(1.65rem,4vw,2.2rem) Oswald,sans-serif; text-transform:uppercase; letter-spacing:.7px; }
    .topo p { display:none; }
    .menu { display:flex; justify-content:center; gap:2px; padding:0 18px; background:#061737f2; backdrop-filter:blur(10px); border-bottom:1px solid #ffffff1f; position:sticky; top:0; z-index:20; flex-wrap:wrap; }
    .menu button { position:relative; background:transparent; color:#bdcdea; border:0; border-bottom:3px solid transparent; padding:15px 19px 13px; cursor:pointer; font:600 .9rem Oswald,sans-serif; letter-spacing:.55px; text-transform:uppercase; transition:color .2s,background .2s; }
    .menu button::before { content:""; position:absolute; top:10px; bottom:10px; left:0; width:1px; background:#ffffff18; }
    .menu button:first-child::before { display:none; }
    .menu button:hover { color:#fff; background:#ffffff0d; }
    .menu button.ativo { color:#fff; border-bottom-color:var(--amarelo); background:linear-gradient(180deg,#ffffff10,transparent); }
    .menu button.ativo::after { content:""; position:absolute; bottom:-3px; left:calc(50% - 3px); border:3px solid transparent; border-bottom-color:var(--amarelo); }
    #conteudo { max-width:1280px; margin:auto; padding:38px 22px 55px; }
    #conteudo.tema-clube { max-width:1324px; margin-top:24px; margin-bottom:35px; padding:32px 44px 44px; border:1px solid color-mix(in srgb, var(--cor-clube) 55%, transparent); border-radius:24px; background:radial-gradient(circle at 100% 0%,color-mix(in srgb, var(--cor-secundaria) 44%, transparent),transparent 40%),linear-gradient(145deg,color-mix(in srgb, #071a3c 52%, var(--cor-clube)) 0%,color-mix(in srgb, #071a3c 62%, var(--cor-secundaria)) 100%); box-shadow:0 16px 34px #0005; }
    #conteudo.tema-clube h2::before { background:var(--cor-clube); }
    #conteudo.tema-clube .acao-principal { background:var(--cor-clube) !important; border-color:var(--cor-clube) !important; color:#fff !important; }
    #conteudo.tema-clube .noticia-clube { background:color-mix(in srgb, var(--cor-clube) 72%, #061a3d); }
    #conteudo.tema-clube .destaque { border-color:color-mix(in srgb, var(--cor-secundaria) 75%, #fff); }
    #conteudo.tema-clube .card { border-color:color-mix(in srgb, var(--cor-clube) 45%, #fff2); }
    #conteudo.tema-clube-claro { border-color:#8d98a9; background:radial-gradient(circle at 100% 0%,#ffffff26,transparent 38%),linear-gradient(135deg,#05070a 0%,#161b22 62%,#0a0d11 100%); color:#f4f6f8; }
    #conteudo.tema-clube-claro h2,#conteudo.tema-clube-claro .escalacao-cabecalho p { color:#f4f6f8; }
    #conteudo.tema-clube-claro .acao-principal { color:#101820 !important; border-color:#cbd1d8 !important; }
    #conteudo.tema-clube-claro .campo { border-color:#59616e; background:linear-gradient(90deg,#929aa5 0 1px,transparent 1px) 50%/20% 100%,linear-gradient(#dfe3e7,#9da5b0); }
    #conteudo.tema-clube-claro .campo::before,#conteudo.tema-clube-claro .campo::after { border-color:#3d4652aa; }
    #conteudo.tema-clube-claro .jogador { color:#111820; border-color:#737d89; background:linear-gradient(145deg,#ffffff,#cbd1d8); box-shadow:0 4px 8px #11182755; }
    #conteudo.tema-clube-claro .jogador .numero { color:#101820; }
    #conteudo.tema-clube-claro .jogador:hover { background:linear-gradient(145deg,#e6e9ed,#9ba4af); color:#081b40; }
    #conteudo.tema-clube-claro .reservas .jogador { background:linear-gradient(145deg,#eef0f3,#bac1ca); }
    h2 { display:flex; align-items:center; gap:12px; margin-bottom:25px; color:white; font:700 clamp(1.7rem,4vw,2.3rem) Oswald,sans-serif; text-transform:uppercase; letter-spacing:.5px; }
    h2::before { content:""; width:7px; height:38px; background:linear-gradient(var(--amarelo),var(--verde)); border-radius:8px; }
    .card { display:flex; gap:24px; align-items:stretch; background:linear-gradient(120deg,#12336b,#0c2451); margin-bottom:18px; padding:14px; border:1px solid #7ca5e438; border-radius:18px; overflow:hidden; box-shadow:0 12px 26px #0004; transition:.25s; }
    .card:hover { transform:translateY(-4px); border-color:var(--amarelo); box-shadow:0 16px 30px #0007; }
    .card > img { width:300px; height:185px; object-fit:cover; border-radius:11px; }
    .noticia-card { position:relative; }
    .noticia-card > img { filter:saturate(1.12) contrast(1.04); }
    .noticia-clube { display:inline-flex; align-items:center; gap:7px; width:max-content; margin-bottom:8px; padding:4px 9px 4px 5px; border-radius:999px; color:#eaf3ff; background:#061a3dcc; font:600 .82rem Oswald,sans-serif; }
    .noticia-clube .escudo { width:25px; height:28px; flex-basis:25px; }
    .pagina-noticias { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr); gap:20px; margin-bottom:34px; }
    .destaque { position:relative; min-height:405px; display:flex; align-items:flex-end; overflow:hidden; border:1px solid #8db7ef55; border-radius:20px; background:#12336b; box-shadow:0 14px 30px #0005; }
    .destaque::after { content:""; position:absolute; inset:0; background:linear-gradient(0deg,#061837 3%,#061837b8 34%,transparent 72%); }
    .destaque > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .destaque-conteudo { position:relative; z-index:1; padding:28px; } .destaque h3 { max-width:670px; color:#fff; font:600 clamp(2rem,4vw,3.2rem)/1.08 Oswald,sans-serif; text-transform:uppercase; text-shadow:0 2px 7px #000; } .destaque p { max-width:620px; margin-top:10px; color:#d7e7ff; line-height:1.55; }
    .destaque .noticia-clube { background:#ffffff20; } .destaque small { display:block; margin-top:13px; color:#9fd4ff; }
    .resumo-noticias { display:grid; gap:14px; } .noticia-resumo { display:grid; grid-template-columns:118px 1fr; gap:13px; align-items:center; padding:11px; min-height:128px; border:1px solid #ffffff20; border-radius:16px; background:#0d2756; transition:.2s; } .noticia-resumo:hover { transform:translateY(-3px); border-color:var(--amarelo); } .noticia-resumo > img { width:118px; height:104px; object-fit:cover; border-radius:10px; } .noticia-resumo h3 { color:#fff; font:600 1.25rem/1.15 Oswald,sans-serif; } .noticia-resumo small { display:block; margin-top:7px; color:#8ec6f9; } .noticia-resumo .noticia-clube { margin-bottom:5px; font-size:.72rem; padding:2px 7px 2px 3px; } .noticia-resumo .noticia-clube .escudo { width:19px; height:22px; flex-basis:19px; }
    .titulo-secao { display:flex; justify-content:space-between; align-items:center; margin:0 0 15px; color:#dbeaff; font:600 1.45rem Oswald,sans-serif; text-transform:uppercase; } .titulo-secao span { color:#8db7ef; font:500 .8rem Roboto,sans-serif; text-transform:none; }
    .lista-noticias { display:grid; grid-template-columns:repeat(3,1fr); gap:15px; } .nota { padding:14px; border-top:3px solid var(--amarelo); border-radius:0 0 14px 14px; background:#0d2756; box-shadow:0 9px 18px #0003; } .nota h3 { margin-top:8px; color:#fff; font:600 1.25rem/1.2 Oswald,sans-serif; } .nota p { margin-top:7px; color:#b9cce9; font-size:.9rem; line-height:1.45; } .nota small { color:#86c8f6; font-size:.76rem; }
    .info { flex:1; display:flex; flex-direction:column; justify-content:center; padding:5px 5px 5px 0; }
    .info h3 { color:var(--amarelo); font:600 1.8rem Oswald,sans-serif; } .info small { color:#85dff0; margin-top:4px; } .info p { color:#d8e5fa; margin-top:12px; line-height:1.65; }
    .clubes { display:grid; grid-template-columns:repeat(auto-fit,minmax(105px,1fr)); gap:16px; }
    .clube-logo { min-height:118px; display:grid; place-items:center; padding:16px; cursor:pointer; border:1px solid #ffffff20; border-radius:18px; background:linear-gradient(135deg,#133873,#0a214c); box-shadow:0 10px 22px #0003; transition:.2s; }
    .clube-logo:hover,.clube-logo:focus-visible { transform:translateY(-4px); border-color:var(--amarelo); outline:none; box-shadow:0 12px 25px #0006; }
    .clube-logo .escudo { width:72px; height:82px; flex-basis:72px; }
    .carrossel-clubes { margin:0 0 34px; padding:18px 0 16px; overflow:hidden; border-top:1px solid #ddd; border-bottom:1px solid #ddd; background:#fff; }
    .carrossel-cabecalho { max-width:1280px; margin:0 auto 13px; padding:0 18px; display:flex; align-items:center; justify-content:space-between; gap:14px; }
    .carrossel-cabecalho h3 { color:#303236; font:700 1rem Roboto,Arial,sans-serif; }
    .carrossel-cabecalho span { color:#777; font-size:.78rem; }
    .carrossel-trilho { display:flex; gap:11px; width:max-content; padding:3px 18px; animation:deslizar-clubes 48s linear infinite; }
    .carrossel-clubes:hover .carrossel-trilho,.carrossel-clubes:focus-within .carrossel-trilho { animation-play-state:paused; }
    .carrossel-time { width:112px; height:100px; flex:0 0 112px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; cursor:pointer; border:1px solid #ddd; border-radius:5px; background:#fff; color:#404246; font:700 .7rem Roboto,Arial,sans-serif; transition:.2s; }
    .carrossel-time:hover,.carrossel-time:focus-visible { transform:translateY(-3px); border-color:#c4172c; color:#c4172c; box-shadow:0 4px 12px #00000012; outline:none; }
    .carrossel-time .escudo { width:50px; height:57px; flex-basis:57px; }
    @keyframes deslizar-clubes { from { transform:translateX(0); } to { transform:translateX(-50%); } }
    .escudo { width:68px; height:76px; flex:0 0 68px; filter:drop-shadow(0 6px 5px #0007); }
    .clube-card h3 { color:#fff; font:600 1.5rem Oswald,sans-serif; } .clube-card p { color:var(--muted); font-size:.9rem; margin-top:4px; line-height:1.4; }
    .tabela-card { background:#0b2250e8; padding:20px; border:1px solid #7ba6e844; border-radius:18px; overflow-x:auto; box-shadow:0 12px 26px #0004; }
    table { width:100%; border-collapse:collapse; min-width:720px; } th { background:#16498e; color:#fff; padding:14px 10px; font:600 .88rem Oswald,sans-serif; text-transform:uppercase; letter-spacing:.3px; } td { padding:11px 9px; border-bottom:1px solid #ffffff14; text-align:center; color:#dce9ff; font-size:.9rem; } tbody tr { transition:.15s; } tbody tr:hover { background:#1c4d92; }
    .time-cell { display:flex; align-items:center; justify-content:flex-start; gap:10px; text-align:left; font-weight:700; white-space:nowrap; } .time-cell .escudo { width:30px; height:34px; flex-basis:30px; }
    .liberta { border-left:5px solid #20d879; } .preliberta { border-left:5px solid var(--amarelo); } .sula { border-left:5px solid #31bbf5; } .rebaixado { border-left:5px solid var(--vermelho); }
    .forma { display:flex; justify-content:center; gap:5px; } .resultado { width:25px; height:25px; display:grid; place-items:center; border-radius:50%; color:#071d49; font-size:.75rem; font-weight:700; } .v{background:#20d879}.e{background:#ffd33d}.d{background:#ef4a60;color:#fff}
    .legenda { display:flex; flex-wrap:wrap; gap:15px; margin-top:20px; color:#c9dcfb; font-size:.85rem; } .item-legenda { display:flex; align-items:center; gap:7px; } .cor { width:13px; height:13px; border-radius:50%; }
    .grid-estatisticas { display:grid; grid-template-columns:1fr 1fr; gap:22px; } .tabela-card h3 { margin-bottom:16px; color:var(--amarelo); font:600 1.55rem Oswald,sans-serif; text-transform:uppercase; }
    .resumo-campeonato { margin-bottom:22px; } .indicador { display:flex; align-items:center; gap:13px; padding:14px 18px; border:1px solid #ffffff1c; border-radius:14px; background:linear-gradient(135deg,#153b76,#0b2554); } .indicador strong { color:var(--amarelo); font:700 2rem Oswald,sans-serif; } .indicador span { color:#b9cdea; font-size:.82rem; text-transform:uppercase; letter-spacing:.4px; } .ranking-card { overflow:hidden; } .ranking-card h3 { display:flex; align-items:center; gap:9px; } .ranking-card h3::before { content:""; width:7px; height:24px; border-radius:5px; background:var(--amarelo); } .ranking-card.cartoes-amarelos h3::before { background:#ffd33d; } .ranking-card.cartoes-vermelhos h3::before { background:#ef4a60; } .ranking-card.assistencias h3::before { background:#40c5ff; }
    .voltar { margin-bottom:20px; padding:9px 15px; cursor:pointer; border:1px solid #8eb4ed; border-radius:999px; background:transparent; color:#fff; font:600 .95rem Oswald,sans-serif; transition:.2s; } .voltar:hover { background:#fff; color:var(--azul); }
    .acoes-pagina { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:20px; } .acoes-pagina .voltar { margin:0; } .acao-principal { background:var(--amarelo) !important; border-color:var(--amarelo) !important; color:#071d49 !important; }
    .escalacao-cabecalho { display:flex; align-items:center; gap:14px; margin-bottom:18px; } .escalacao-cabecalho .escudo { width:52px; height:58px; flex-basis:52px; }
    .campo { display:grid; grid-template-columns:repeat(5,1fr); grid-template-rows:repeat(4,1fr); gap:12px 8px; min-height:510px; padding:30px 16px; border:7px solid #d8f7dc; border-radius:18px; background:linear-gradient(90deg,#16834d 0 1px,transparent 1px) 50%/20% 100%,linear-gradient(#229f5b,#137943); box-shadow:inset 0 0 0 1px #fff8,0 12px 26px #0005; position:relative; overflow:hidden; }
    .campo::before { content:""; position:absolute; left:12%; right:12%; top:50%; border-top:2px solid #e2ffe999; } .campo::after { content:""; position:absolute; left:50%; top:50%; width:100px; height:100px; border:2px solid #e2ffe999; border-radius:50%; transform:translate(-50%,-50%); }
    .jogador { z-index:1; align-self:center; justify-self:center; width:min(100%,130px); padding:7px 5px; cursor:pointer; border:1px solid #fff9; border-radius:9px; color:#fff; background:#092b5fe8; box-shadow:0 4px 8px #0004; font:600 .78rem/1.1 Roboto,sans-serif; transition:.18s; } .jogador:hover,.jogador:focus-visible { background:var(--amarelo); color:#061a3d; transform:translateY(-3px) scale(1.03); outline:none; } .jogador .numero { display:block; margin-bottom:2px; color:#ffdc57; font:700 .95rem Oswald,sans-serif; } .jogador .posicao { display:block; margin-top:3px; opacity:.78; font-size:.63rem; font-weight:400; } .jogador:hover .numero { color:#0b3d91; }
    .campo .jogador:nth-child(1){grid-column:3;grid-row:4}.campo .jogador:nth-child(2){grid-column:1;grid-row:3}.campo .jogador:nth-child(3){grid-column:2;grid-row:3}.campo .jogador:nth-child(4){grid-column:4;grid-row:3}.campo .jogador:nth-child(5){grid-column:5;grid-row:3}.campo .jogador:nth-child(6){grid-column:2;grid-row:2}.campo .jogador:nth-child(7){grid-column:3;grid-row:2}.campo .jogador:nth-child(8){grid-column:4;grid-row:2}.campo .jogador:nth-child(9){grid-column:1;grid-row:1}.campo .jogador:nth-child(10){grid-column:3;grid-row:1}.campo .jogador:nth-child(11){grid-column:5;grid-row:1}
    .reservas-titulo { margin:25px 0 12px; color:#dceaff; font:600 1.25rem Oswald,sans-serif; text-transform:uppercase; } .reservas { display:grid; grid-template-columns:repeat(auto-fit,minmax(125px,1fr)); gap:10px; } .reservas .jogador { width:100%; min-height:58px; background:#143875; text-align:left; }
    .modal-estatisticas { position:fixed; inset:0; z-index:50; display:grid; place-items:center; padding:18px; background:#020b1bb8; backdrop-filter:blur(5px); } .painel-estatisticas { width:min(100%,560px); padding:25px; border:1px solid #83b7fa77; border-radius:20px; background:linear-gradient(145deg,#163d7c,#081c42); box-shadow:0 22px 45px #0009; position:relative; } .fechar-modal { position:absolute; top:12px; right:14px; width:34px; height:34px; cursor:pointer; border:0; border-radius:50%; color:#fff; background:#ffffff22; font-size:1.4rem; } .fechar-modal:hover { background:var(--vermelho); } .painel-estatisticas h2 { margin:8px 0 4px; font-size:2rem; } .painel-estatisticas h2::before { display:none; } .painel-estatisticas > p { color:#a8c7ef; margin-bottom:20px; } .grade-estatisticas { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; } .estatistica { padding:12px 8px; border-radius:11px; text-align:center; background:#ffffff12; } .estatistica strong { display:block; color:var(--amarelo); font:700 1.35rem Oswald,sans-serif; } .estatistica span { color:#c9dcf7; font-size:.77rem; }
    /* Portal editorial: visual claro, limpo e inspirado em portais esportivos nacionais */
    :root { --azul:#1f1f1f; --azul-medio:#b30f1f; --verde:#16884b; --amarelo:#b30f1f; --vermelho:#c4172c; --texto:#202124; --muted:#687078; --card:#fff; }
    body { background:#f5f5f5; color:#202124; }
    .topo { padding:17px 24px; background:#c4172c; border:0; box-shadow:none; }
    .marca { justify-content:flex-start; gap:10px; }
    .logo-serie-a { width:42px; height:42px; padding:4px; border-radius:50%; background:#fff; filter:none; }
    .topo h1 { color:#fff; font-family:Roboto,Arial,sans-serif; font-size:clamp(1.45rem,3.5vw,2rem); font-weight:700; letter-spacing:-.5px; text-transform:none; }
    .menu { justify-content:flex-start; gap:0; padding:0 max(18px,calc((100vw - 1280px)/2)); background:#fff; border-bottom:1px solid #ddd; box-shadow:0 2px 6px #0000000b; }
    .menu button { color:#4f555b; border-bottom-width:3px; padding:14px 18px 12px; font-family:Roboto,Arial,sans-serif; font-size:.82rem; letter-spacing:0; }
    .menu button::before { display:none; }.menu button:hover { color:#c4172c; background:#f7f7f7; }.menu button.ativo { color:#c4172c; border-bottom-color:#c4172c; background:transparent; }.menu button.ativo::after { display:none; }
    #conteudo { padding:32px 22px 55px; }
    h2 { color:#202124; font-family:Roboto,Arial,sans-serif; font-size:clamp(1.6rem,3vw,2.1rem); font-weight:700; text-transform:none; letter-spacing:-.6px; } h2::before { width:5px; height:32px; background:#c4172c; border-radius:0; }
    .card { background:#fff; border:1px solid #dedede; border-radius:5px; box-shadow:none; }.card:hover { border-color:#c4172c; box-shadow:0 4px 14px #00000012; }.info h3 { color:#202124; font-family:Roboto,Arial,sans-serif; font-size:1.5rem; }.info small { color:#777; }.info p { color:#53575b; }.noticia-clube { color:#fff; background:#c4172c; border-radius:3px; font-family:Roboto,Arial,sans-serif; font-weight:700; }
    .destaque { border-color:#ddd; border-radius:5px; box-shadow:none; }.destaque::after { background:linear-gradient(0deg,#111 4%,#111b5 43%,transparent 78%); }.destaque h3 { font-family:Roboto,Arial,sans-serif; font-weight:700; text-transform:none; letter-spacing:-1px; }.destaque small { color:#eee; }
    .noticia-resumo,.nota { background:#fff; border:1px solid #ddd; border-radius:5px; box-shadow:none; }.noticia-resumo:hover { border-color:#c4172c; }.noticia-resumo h3,.nota h3 { color:#252525; font-family:Roboto,Arial,sans-serif; }.noticia-resumo small,.nota small { color:#777; }.nota { border-top:3px solid #c4172c; }.nota p { color:#60656a; }.titulo-secao { color:#202124; font-family:Roboto,Arial,sans-serif; }.titulo-secao span { color:#777; }
    .clube-logo { background:#fff; border:1px solid #ddd; border-radius:5px; box-shadow:none; }.clube-logo:hover,.clube-logo:focus-visible { border-color:#c4172c; box-shadow:0 4px 12px #00000010; }.escudo { filter:drop-shadow(0 2px 2px #0003); }
    .tabela-card { background:#fff; border:1px solid #ddd; border-radius:5px; box-shadow:none; } th { background:#333; } td { color:#34383c; border-bottom-color:#e7e7e7; } tbody tr:hover { background:#f7f7f7; }.legenda { color:#555; }
    .indicador,.painel-estatisticas { background:#fff; border-color:#ddd; box-shadow:none; }.indicador strong,.tabela-card h3 { color:#c4172c; }.indicador span { color:#676c70; }.ranking-card h3::before { background:#c4172c; }.voltar { color:#c4172c; border-color:#c4172c; }.voltar:hover { background:#c4172c; color:#fff; }
    #conteudo.tema-clube { background:#fff; color:#202124; border-color:color-mix(in srgb,var(--cor-clube) 55%,#ddd); box-shadow:none; } #conteudo.tema-clube h2 { color:#202124; } #conteudo.tema-clube .card { background:#fff; } #conteudo.tema-clube .info h3 { color:#202124; } #conteudo.tema-clube .info p { color:#53575b; } #conteudo.tema-clube .titulo-secao { color:#202124; }
    .reservas-titulo,.escalacao-cabecalho p { color:#30343a; }.campo { box-shadow:none; }.modal-estatisticas { background:#0008; }.painel-estatisticas { color:#202124; }.painel-estatisticas > p,.estatistica span { color:#62676c; }.estatistica { background:#f3f3f3; }.estatistica strong { color:#c4172c; }.fechar-modal { background:#c4172c; }
    /* Cabeçalho com a identidade visual do portal */
    .topo { padding:0; background:#fff; border-top:5px solid #c4172c; border-bottom:1px solid #dedede; box-shadow:none; }
    .marca { min-height:76px; padding:12px 24px; justify-content:flex-start; }
    .logo-portal { display:block; width:390px; height:60px; object-fit:cover; object-position:center; }
    .menu { min-height:48px; justify-content:flex-start; padding:0 max(18px,calc((100vw - 1280px)/2)); background:#fff; border-bottom:2px solid #c4172c; box-shadow:none; }
    .menu button { padding:14px 20px 12px; color:#34363a; font-weight:700; }.menu button.ativo { color:#c4172c; }
    .rodape { margin-top:28px; border-top:4px solid #c4172c; background:#252525; color:#d9d9d9; }
    .rodape-conteudo { max-width:1280px; margin:auto; padding:32px 24px 24px; display:grid; grid-template-columns:1.25fr .8fr .8fr; gap:34px; }
    .rodape-marca { display:flex; align-items:center; gap:11px; margin-bottom:10px; color:#fff; font:700 1.2rem Roboto,Arial,sans-serif; }
    .rodape-marca img { width:38px; height:38px; padding:3px; border-radius:50%; background:#fff; }
    .rodape p { max-width:390px; color:#aaa; font-size:.84rem; line-height:1.55; }
    .rodape h3 { margin:4px 0 12px; color:#fff; font:700 .82rem Roboto,Arial,sans-serif; text-transform:uppercase; letter-spacing:.45px; }
    .rodape-links { display:grid; gap:8px; }
    .rodape-links button { width:max-content; padding:0; cursor:pointer; border:0; background:transparent; color:#cfcfcf; font:400 .86rem Roboto,Arial,sans-serif; text-align:left; transition:color .2s; }
    .rodape-links button:hover,.rodape-links button:focus-visible { color:#fff; outline:none; }
    .rodape-atualizacao { padding-left:15px; border-left:2px solid #c4172c; color:#bdbdbd; font-size:.84rem; line-height:1.55; }
    .rodape-atualizacao strong { display:block; color:#fff; margin-bottom:3px; }
    .rodape-base { border-top:1px solid #4a4a4a; }
    .rodape-base-conteudo { max-width:1280px; min-height:54px; margin:auto; padding:0 24px; display:flex; align-items:center; justify-content:space-between; gap:15px; color:#aaa; font-size:.75rem; }
    .voltar-topo { cursor:pointer; border:0; background:transparent; color:#fff; font:700 .75rem Roboto,Arial,sans-serif; text-transform:uppercase; }
    .voltar-topo:hover { color:#e96b78; }
    /* Painel de estatísticas: leitura rápida, como nos grandes portais esportivos */
    .estatisticas-cabecalho { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid #dedede; }
    .estatisticas-cabecalho h2 { margin:0; }
    .estatisticas-atualizacao { color:#74777b; font-size:.78rem; }
    .destaques-estatisticas { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:26px; }
    .destaque-estatistica { position:relative; min-height:132px; padding:17px; overflow:hidden; border:1px solid #ddd; border-radius:5px; background:#fff; box-shadow:0 2px 8px #0000000a; }
    .destaque-estatistica::before { content:""; position:absolute; top:0; left:0; width:100%; height:4px; background:#c4172c; }
    .destaque-estatistica.assistencias::before { background:#1677b8; }.destaque-estatistica.amarelos::before { background:#e2ae00; }.destaque-estatistica.vermelhos::before { background:#c4172c; }
    .destaque-estatistica small { display:block; color:#74777b; font:700 .7rem Roboto,Arial,sans-serif; text-transform:uppercase; letter-spacing:.45px; }
    .destaque-estatistica strong { display:block; margin:8px 0 3px; color:#24272b; font:700 1.3rem Roboto,Arial,sans-serif; }
    .destaque-estatistica span { color:#676c70; font-size:.8rem; }.destaque-estatistica b { color:#c4172c; font-size:1.7rem; }.destaque-estatistica.assistencias b { color:#1677b8; }.destaque-estatistica.amarelos b { color:#b78200; }
    .stat-tabs { display:flex; flex-wrap:wrap; gap:8px; margin:-8px 0 13px; }.stat-tabs button { cursor:pointer; padding:8px 12px; border:1px solid #d6d6d6; border-radius:3px; color:#4b5055; background:#fff; font:700 .76rem Roboto,Arial,sans-serif; }.stat-tabs button.ativo { border-color:#c4172c; color:#fff; background:#c4172c; }.busca-estatisticas { width:min(100%,380px); margin:0 0 18px; padding:10px 12px; border:1px solid #cfd1d3; border-radius:4px; color:#303236; font:400 .86rem Roboto,Arial,sans-serif; }.sem-resultados { padding:16px; color:#73777b; font-size:.85rem; }
    .grid-estatisticas { gap:18px; }
    .ranking-card { padding:0; overflow:hidden; }.ranking-card h3 { margin:0; padding:16px 18px 12px; border-bottom:1px solid #e8e8e8; color:#24272b; font:700 1.05rem Roboto,Arial,sans-serif; text-transform:none; }.ranking-card h3::before { width:4px; height:22px; border-radius:0; background:#c4172c; }
    .ranking-lista { list-style:none; }.ranking-item { display:grid; grid-template-columns:30px minmax(0,1fr) auto; align-items:center; gap:10px; padding:11px 16px; border-bottom:1px solid #eeeeee; }.ranking-item:last-child { border-bottom:0; }.ranking-item:hover { background:#fafafa; }
    .ranking-posicao { display:grid; place-items:center; width:26px; height:26px; border-radius:50%; color:#6d7175; background:#f0f0f0; font:700 .76rem Roboto,Arial,sans-serif; }.ranking-item:first-child .ranking-posicao { color:#fff; background:#c4172c; }
    .ranking-jogador { display:flex; align-items:center; gap:9px; min-width:0; }.ranking-jogador .escudo { width:26px; height:30px; flex-basis:26px; filter:none; }.ranking-jogador strong { overflow:hidden; color:#303236; text-overflow:ellipsis; white-space:nowrap; font-size:.9rem; }.ranking-jogador span { display:block; margin-top:2px; color:#7a7e82; font-size:.72rem; }
    .ranking-numero { min-width:62px; color:#c4172c; text-align:right; font:700 1.2rem Roboto,Arial,sans-serif; }.ranking-numero small { display:block; color:#74777b; font:500 .65rem Roboto,Arial,sans-serif; text-transform:uppercase; }.ranking-card.assistencias .ranking-numero { color:#1677b8; }.ranking-card.cartoes-amarelos .ranking-numero { color:#b78200; }
    /* Simulador de classificação */
    .simulador-intro { max-width:790px; margin:-12px 0 22px; color:#5f656b; line-height:1.55; }
    .simulador-layout { display:grid; grid-template-columns:minmax(310px,.9fr) minmax(0,1.45fr); gap:22px; align-items:start; }
    .simulador-jogos { overflow:hidden; border:1px solid #ddd; border-radius:6px; background:#fff; }.simulador-jogos-cabecalho { padding:16px 18px; border-bottom:3px solid #c4172c; }.simulador-jogos-cabecalho h3 { color:#252525; font:700 1.05rem Roboto,Arial,sans-serif; }.simulador-jogos-cabecalho p { margin-top:4px; color:#74777b; font-size:.78rem; }
    .jogo-simulador { display:grid; grid-template-columns:1fr 104px 1fr; align-items:center; gap:8px; padding:12px 14px; border-bottom:1px solid #ececec; }.jogo-simulador:last-of-type { border-bottom:0; }.time-simulador { display:flex; align-items:center; gap:7px; min-width:0; color:#303236; font:700 .79rem Roboto,Arial,sans-serif; }.time-simulador.visitante { justify-content:flex-end; text-align:right; }.time-simulador .escudo { width:27px; height:31px; flex-basis:27px; filter:none; }.time-simulador span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .resultado-simulador { width:100%; display:flex; align-items:center; justify-content:center; gap:5px; padding:5px; border:1px solid #cfd1d3; border-radius:4px; background:#fff; color:#3b3e42; font:700 .85rem Roboto,Arial,sans-serif; text-align:center; }.resultado-simulador input { width:33px; padding:5px 2px; border:0; border-bottom:2px solid #cfd1d3; color:#303236; background:transparent; font:700 1rem Roboto,Arial,sans-serif; text-align:center; }.resultado-simulador input:focus { border-bottom-color:#c4172c; outline:none; }
    .simulador-acoes { display:flex; justify-content:flex-end; gap:8px; padding:12px 14px; border-top:1px solid #e8e8e8; background:#fafafa; }.limpar-simulacao { cursor:pointer; padding:8px 12px; border:1px solid #c4172c; border-radius:3px; background:#fff; color:#c4172c; font:700 .72rem Roboto,Arial,sans-serif; text-transform:uppercase; }.limpar-simulacao:hover { background:#c4172c; color:#fff; }.sortear-simulacao { cursor:pointer; padding:8px 12px; border:1px solid #303236; border-radius:3px; background:#303236; color:#fff; font:700 .72rem Roboto,Arial,sans-serif; text-transform:uppercase; }.sortear-simulacao:hover { background:#101112; }
    .tabela-simulada { position:sticky; top:60px; }.tabela-simulada .tabela-card { padding:0; }.tabela-simulada-cabecalho { display:flex; justify-content:space-between; align-items:center; gap:10px; padding:16px 18px; border-bottom:1px solid #e5e5e5; }.tabela-simulada-cabecalho h3 { color:#252525; font:700 1.05rem Roboto,Arial,sans-serif; }.tabela-simulada-cabecalho span { color:#74777b; font-size:.72rem; }
    .tabela-simulada table { min-width:570px; }.tabela-simulada th { padding:11px 8px; font-size:.76rem; }.tabela-simulada td { padding:8px 7px; font-size:.78rem; }.tabela-simulada .time-cell { gap:7px; }.tabela-simulada .time-cell .escudo { width:23px; height:27px; flex-basis:23px; }
    .rodadas-lista { display:grid; gap:18px; }.rodada-card { padding:0; overflow:hidden; }.rodada-cabecalho { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:15px 18px; border-bottom:3px solid #c4172c; }.rodada-cabecalho h3 { color:#252525; font:700 1.08rem Roboto,Arial,sans-serif; }.rodada-cabecalho span { color:#73777b; font-size:.76rem; }
    .partida { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:13px; padding:12px 18px; border-bottom:1px solid #ededed; }.partida:last-child { border-bottom:0; }.partida-time { display:flex; align-items:center; gap:9px; color:#303236; font:700 .85rem Roboto,Arial,sans-serif; }.partida-time.visitante { justify-content:flex-end; text-align:right; }.partida-time .escudo { width:29px; height:33px; flex-basis:29px; filter:none; }.partida-placar { min-width:88px; color:#303236; text-align:center; font:700 .9rem Roboto,Arial,sans-serif; }.partida-placar small { display:block; margin-top:3px; color:#7b7f82; font:500 .66rem Roboto,Arial,sans-serif; }
    .meu-clube-painel { max-width:720px; padding:24px; border:1px solid #ddd; border-top:4px solid #c4172c; border-radius:5px; background:#fff; }.meu-clube-painel p { margin:7px 0 18px; color:#61666b; line-height:1.5; }.meu-clube-controles { display:flex; gap:10px; flex-wrap:wrap; }.meu-clube-controles select { flex:1 1 260px; padding:10px 12px; border:1px solid #cfd1d3; border-radius:4px; color:#34363a; background:#fff; font:600 .88rem Roboto,Arial,sans-serif; }.botao-clube { cursor:pointer; padding:10px 14px; border:1px solid #c4172c; border-radius:4px; color:#fff; background:#c4172c; font:700 .76rem Roboto,Arial,sans-serif; text-transform:uppercase; }.botao-clube.secundario { color:#c4172c; background:#fff; }.meu-clube-salvo { display:flex; align-items:center; gap:14px; margin-top:22px; padding:16px; border:1px solid #e0e0e0; background:#f8f8f8; }.meu-clube-salvo .escudo { width:45px; height:51px; flex-basis:45px; filter:none; }.meu-clube-salvo strong { display:block; color:#24272b; }.meu-clube-salvo span { display:block; margin-top:3px; color:#6e7378; font-size:.8rem; }
    /* Identidade visual de cada clube */
    #conteudo.tema-clube { position:relative; overflow:hidden; border-top:7px solid var(--cor-clube); }
    #conteudo.tema-clube::before { content:""; position:absolute; top:0; right:0; width:210px; height:7px; background:repeating-linear-gradient(90deg,var(--cor-clube) 0 14px,var(--cor-secundaria) 14px 28px); }
    .identidade-clube { position:relative; display:flex; align-items:center; gap:15px; min-height:104px; margin:0 0 25px; padding:17px 22px; overflow:hidden; border-radius:6px; background:linear-gradient(90deg,#0008,#0004),repeating-linear-gradient(-45deg,var(--cor-clube) 0 15px,var(--cor-secundaria) 15px 30px); box-shadow:inset 0 0 0 1px #ffffff36; }
    .identidade-clube::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,#00000042,transparent 70%); pointer-events:none; }
    .identidade-clube .escudo { position:relative; z-index:1; width:68px; height:76px; flex-basis:68px; padding:4px; border-radius:4px; background:#fff; }
    .identidade-clube div { position:relative; z-index:1; color:#fff; }
    .identidade-clube small { display:block; margin-bottom:4px; font:700 .72rem Roboto,Arial,sans-serif; letter-spacing:.5px; text-transform:uppercase; }
    .identidade-clube strong { display:block; font:700 clamp(1.45rem,4vw,2.2rem) Roboto,Arial,sans-serif; letter-spacing:-.7px; }
    #conteudo.tema-clube .destaque { border-left:6px solid var(--cor-clube); }
    #conteudo.tema-clube .noticia-card { border-left:4px solid var(--cor-clube); }
    #conteudo.tema-clube .noticia-card::before { content:""; width:9px; align-self:stretch; margin:-14px 0 -14px -14px; background:repeating-linear-gradient(180deg,var(--cor-clube) 0 12px,var(--cor-secundaria) 12px 24px); }
    @media(max-width:720px){ .marca{min-height:68px;padding:10px 14px}.logo-portal{width:min(390px,100%);height:54px}.menu{border-bottom-width:1px} }
    @media(max-width:850px){ .pagina-noticias{grid-template-columns:1fr}.resumo-noticias{grid-template-columns:1fr 1fr}.destaque{min-height:360px}.lista-noticias{grid-template-columns:1fr 1fr}.destaques-estatisticas{grid-template-columns:repeat(2,1fr)}.simulador-layout{grid-template-columns:1fr}.tabela-simulada{position:static} }
    @media(max-width:720px){ .topo{padding:0}.logo-serie-a{width:41px;height:41px}.menu{justify-content:stretch;padding:0}.menu button{flex:1 1 45%;padding:12px 5px 10px;font-size:.8rem}.menu button::before{display:none}.card{flex-direction:column}.card>img{width:100%;height:180px}.info{padding:3px}.grid-estatisticas{grid-template-columns:1fr}.resumo-campeonato{grid-template-columns:1fr 1fr}#conteudo{padding:30px 14px}#conteudo.tema-clube{margin:15px 10px 25px;padding:24px 16px 32px}.tabela-card{padding:12px}.clubes{grid-template-columns:repeat(3,1fr);gap:12px}.clube-logo{min-height:105px;padding:12px}.carrossel-clubes{margin-left:-14px;margin-right:-14px}.carrossel-time{width:98px;flex-basis:98px;height:92px}.carrossel-time .escudo{width:44px;height:50px;flex-basis:50px}.carrossel-cabecalho{padding:0 14px}.carrossel-cabecalho span{font-size:.7rem}.resumo-noticias,.lista-noticias{grid-template-columns:1fr}.destaque{min-height:350px}.destaque-conteudo{padding:20px}.noticia-resumo{grid-template-columns:100px 1fr}.noticia-resumo>img{width:100px;height:94px}.campo{min-height:460px;padding:20px 6px;gap:7px 3px}.jogador{font-size:.64rem;padding:6px 2px}.reservas{grid-template-columns:repeat(2,1fr)}.grade-estatisticas{grid-template-columns:repeat(2,1fr)}.rodape-conteudo{grid-template-columns:1fr;gap:24px;padding:28px 14px 22px}.rodape-base-conteudo{padding:13px 14px;align-items:flex-start;flex-direction:column}.rodape-atualizacao{max-width:340px}.identidade-clube{min-height:92px;padding:14px}.identidade-clube .escudo{width:56px;height:64px;flex-basis:56px}.identidade-clube strong{font-size:1.35rem}.estatisticas-cabecalho{align-items:flex-start;flex-direction:column;gap:6px}.destaques-estatisticas{grid-template-columns:1fr 1fr;gap:10px}.destaque-estatistica{min-height:118px;padding:14px}.destaque-estatistica strong{font-size:1.05rem}.ranking-item{padding:10px 12px}.jogo-simulador{grid-template-columns:1fr 92px 1fr;padding:10px}.time-simulador{font-size:.72rem}.simulador-jogos{margin:0 -2px}.partida{gap:7px;padding:10px}.partida-time{font-size:.72rem}.partida-time .escudo{width:24px;height:28px;flex-basis:24px}.partida-placar{min-width:65px;font-size:.8rem} }
  </style>
</head>
<body>
  <header class="topo">
    <div class="marca"><img class="logo-portal" src="assets/logo-portal-brasileirao.jpeg" alt="Portal do Brasileirão"></div>
  </header>
  <nav class="menu" aria-label="Navegação principal">
    <button class="ativo" onclick="mostrar('noticias', this)">Notícias</button><button onclick="mostrar('times', this)">Times</button><button onclick="mostrar('meuClube', this)">Meu clube</button><button onclick="mostrar('tabela', this)">Tabela atualizada</button><button onclick="mostrar('jogos', this)">Jogos</button><button onclick="mostrar('estatisticas', this)">Estatísticas</button><button onclick="mostrar('simulador', this)">Simulador</button>
  </nav>
  <main id="conteudo"></main>
  <footer class="rodape">
    <div class="rodape-conteudo">
      <section>
        <div class="rodape-marca"><img src="https://r2.thesportsdb.com/images/media/league/badge/lywv7t1766787179.png" alt="Logo do Brasileirão Série A">Portal do Brasileirão</div>
        <p>Informação clara para acompanhar cada rodada, os clubes, a tabela e os principais números do Campeonato Brasileiro.</p>
      </section>
      <section>
        <h3>Explore o portal</h3>
        <div class="rodape-links">
          <button onclick="mostrar('noticias',document.querySelectorAll('.menu button')[0])">Últimas notícias</button>
          <button onclick="mostrar('times',document.querySelectorAll('.menu button')[1])">Clubes do Brasileirão</button>
          <button onclick="mostrar('tabela',document.querySelectorAll('.menu button')[2])">Tabela atualizada</button>
          <button onclick="mostrar('meuClube',document.querySelectorAll('.menu button')[2])">Meu clube</button>
          <button onclick="mostrar('jogos',document.querySelectorAll('.menu button')[4])">Jogos e rodadas</button>
          <button onclick="mostrar('estatisticas',document.querySelectorAll('.menu button')[5])">Estatísticas</button>
          <button onclick="mostrar('simulador',document.querySelectorAll('.menu button')[6])">Simulador de classificação</button>
        </div>
      </section>
      <section>
        <h3>Informações</h3>
        <div class="rodape-atualizacao"><strong>Dados do portal</strong>Conteúdos e rankings exibidos conforme a última atualização disponível no projeto.</div>
      </section>
    </div>
    <div class="rodape-base"><div class="rodape-base-conteudo"><span>© 2026 Portal do Brasileirão. Projeto informativo.</span><button class="voltar-topo" onclick="window.scrollTo({top:0,behavior:'smooth'})">Voltar ao topo ↑</button></div></div>
  </footer>
  <script>
    const clubes = [
      ['Palmeiras','PAL','#08783f','#fff','O Verdão lidera com consistência defensiva.'],['Flamengo','FLA','#d91f32','#111','O Rubro-Negro tem um dos ataques mais fortes.'],['Corinthians','COR','#171717','#fff','O Timão busca recuperação na temporada.'],['São Paulo','SPF','#fff','#d82839','O Tricolor aposta na força do elenco.'],['Santos','SAN','#f3f3f3','#151515','O Peixe valoriza os jovens talentos.'],['Grêmio','GRE','#1e75c9','#fff','O Imortal busca regularidade no campeonato.'],['Internacional','INT','#c8222b','#fff','O Colorado tenta subir na classificação.'],['Atlético-MG','CAM','#171717','#fff','O Galo briga pelas primeiras posições.'],['Vasco da Gama','VAS','#111','#fff','O Vasco quer se afastar da parte de baixo.'],['Cruzeiro','CRU','#1f4ea5','#fff','A Raposa procura estabilidade.'],['Bahia','BAH','#1972c7','#fff','O Bahia sonha com competições internacionais.'],['Coritiba','CFC','#158248','#fff','O Coxa luta para subir na tabela.'],['Mirassol','MIR','#f0c419','#111','O Mirassol busca se manter competitivo.'],['Remo','REM','#1c5eaf','#fff','O Leão Azul quer evoluir.'],['Chapecoense','CHA','#13814a','#fff','A Chape tenta reagir no campeonato.'],['Fluminense','FLU','#7c2433','#fff','O Tricolor carioca segue entre os líderes.'],['Athletico-PR','CAP','#b71d35','#fff','O Furacão mantém campanha competitiva.'],['Bragantino','RBB','#e52d35','#fff','O Massa Bruta mira a parte alta.'],['Botafogo','BOT','#121212','#fff','O Glorioso busca regularidade.'],['Vitória','VIT','#d62333','#111','O Leão baiano busca pontos importantes.']
    ];
    const clubePorNome = Object.fromEntries(clubes.map(c=>[c[0],c]));
    let clubeFavorito=(()=>{try{return localStorage.getItem('clubeFavoritoBrasileirao')||''}catch(e){return''}})();
    const midiaClubes = {
      'Palmeiras':['https://r2.thesportsdb.com/images/media/team/badge/vsqwqp1473538105.png','https://r2.thesportsdb.com/images/media/team/fanart/7cg5cc1749462887.jpg'],
      'Flamengo':['https://r2.thesportsdb.com/images/media/team/badge/syptwx1473538074.png','https://r2.thesportsdb.com/images/media/team/fanart/s940nz1749463096.jpg'],
