      'Internacional':['https://r2.thesportsdb.com/images/media/team/badge/yprvxx1473538097.png','https://r2.thesportsdb.com/images/media/team/fanart/y14rv61749468816.jpg'],
      'Atlético-MG':['https://r2.thesportsdb.com/images/media/team/badge/x5lixs1743742872.png','https://r2.thesportsdb.com/images/media/team/fanart/55ipzj1749400845.jpg'],
      'Vasco da Gama':['https://r2.thesportsdb.com/images/media/team/badge/ynqlxo1630521109.png','https://r2.thesportsdb.com/images/media/team/fanart/u7ij2e1749482983.jpg'],
      'Cruzeiro':['https://r2.thesportsdb.com/images/media/team/badge/upsvvu1473538059.png','https://r2.thesportsdb.com/images/media/team/fanart/oni7bg1749462512.jpg'],
      'Bahia':['https://r2.thesportsdb.com/images/media/team/badge/xuvtsv1473539308.png','https://r2.thesportsdb.com/images/media/team/fanart/v64gdz1749401247.jpg'],
      'Coritiba':['https://r2.thesportsdb.com/images/media/team/badge/ywwsyu1473538050.png','https://r2.thesportsdb.com/images/media/team/fanart/rwusyv1422237480.jpg'],
      'Mirassol':['https://r2.thesportsdb.com/images/media/team/badge/pw8uo11765900737.png','https://r2.thesportsdb.com/images/media/team/fanart/ri5oz91749479557.jpg'],
      'Remo':['https://r2.thesportsdb.com/images/media/team/badge/u36jfy1579341655.png','https://r2.thesportsdb.com/images/media/team/fanart/5gsf9x1767714081.jpg'],
      'Chapecoense':['https://r2.thesportsdb.com/images/media/team/badge/wy0e1i1765900601.png','https://r2.thesportsdb.com/images/media/team/fanart/pmnbl41767210067.jpg'],
      'Fluminense':['https://r2.thesportsdb.com/images/media/team/badge/stvvwp1473538082.png','https://r2.thesportsdb.com/images/media/team/fanart/a6hxeq1660280979.jpg'],
      'Athletico-PR':['https://r2.thesportsdb.com/images/media/team/badge/irzu1u1554237406.png','https://r2.thesportsdb.com/images/media/team/fanart/trplwq1767190843.jpg'],
      'Bragantino':['https://r2.thesportsdb.com/images/media/team/badge/sqwrcu1646600551.png','https://images.unsplash.com/photo-1522778119026-d647f0596c20?q=80&w=900&auto=format&fit=crop'],
      'Botafogo':['https://r2.thesportsdb.com/images/media/team/badge/bs5mbw1733004596.png','https://r2.thesportsdb.com/images/media/team/fanart/ccs8l81736390613.jpg'],
      'Vitória':['https://r2.thesportsdb.com/images/media/team/badge/tysrrx1473538156.png','https://r2.thesportsdb.com/images/media/team/fanart/r79mig1749484180.jpg']
    };
    function escudo(clube, pequeno=false){ const nome=clube[0], dimensao=pequeno?34:78; return `<img class="escudo" width="${dimensao}" height="${pequeno?38:86}" alt="Escudo do ${nome}" src="${midiaClubes[nome][0]}">`; }
    function forma(lista){ return `<div class="forma">${lista.map(r=>`<span class="resultado ${r==='V'?'v':r==='E'?'e':'d'}">${r}</span>`).join('')}</div>`; }
    function carrosselClubes(){ const itens=clubes.concat(clubes); return `<section class="carrossel-clubes" aria-label="Clubes do Brasileirão"><div class="carrossel-cabecalho"><h3>Clubes do Brasileirão</h3><span>Clique no escudo para ver o clube</span></div><div class="carrossel-trilho">${itens.map(c=>`<button class="carrossel-time" onclick="mostrarNoticiasDoClube('${c[0]}')" aria-label="Ver notícias e escalação do ${c[0]}">${escudo(c,true)}<span>${c[0]}</span></button>`).join('')}</div></section>`; }
    function noticias(){ const itens=[['Palmeiras','Palmeiras amplia liderança','27/05/2026','Com mais uma vitória convincente, o Verdão segue isolado na ponta da tabela.'],['Flamengo','Flamengo mantém perseguição','26/05/2026','A equipe carioca venceu fora de casa e segue firme na briga pelo título.'],['Corinthians','Corinthians busca reação','25/05/2026','O Timão trabalha para transformar a boa atuação em resultados na competição.'],['São Paulo','São Paulo prepara ajustes para a rodada','25/05/2026','O Tricolor concentra os trabalhos na preparação do próximo confronto.'],['Fluminense','Fluminense mantém foco no G-4','24/05/2026','O time carioca busca regularidade para seguir entre os primeiros colocados.'],['Cruzeiro','Cruzeiro mira sequência positiva','24/05/2026','A Raposa trabalha para somar pontos importantes no campeonato.']]; const artigo=(i)=>`<div class="noticia-clube">${escudo(clubePorNome[i[0]],true)}${i[0]}</div><h3>${i[1]}</h3><small>${i[2]}</small><p>${i[3]}</p>`; return `${carrosselClubes()}<h2>Últimas notícias</h2><section class="pagina-noticias"><article class="destaque"><img src="${midiaClubes[itens[0][0]][1]}" alt="Imagem do ${itens[0][0]}"><div class="destaque-conteudo">${artigo(itens[0])}</div></article><aside class="resumo-noticias">${itens.slice(1,3).map(i=>`<article class="noticia-resumo"><img src="${midiaClubes[i[0]][1]}" alt="Imagem do ${i[0]}"><div>${artigo(i)}</div></article>`).join('')}</aside></section><div class="titulo-secao">Mais notícias <span>Atualizado hoje</span></div><section class="lista-noticias">${itens.slice(3).map(i=>`<article class="nota">${artigo(i)}</article>`).join('')}</section>`; }
    function times(){ return `<h2>Clubes do Brasileirão</h2><section class="clubes" aria-label="Selecione um clube para ver suas notícias">${clubes.map(c=>`<button class="clube-logo" onclick="mostrarNoticiasDoClube('${c[0]}')" aria-label="Ver notícias do ${c[0]}" title="Ver notícias do ${c[0]}">${escudo(c)}</button>`).join('')}</section>`; }
    function salvarMeuClube(){ const seletor=document.getElementById('seletor-meu-clube'); clubeFavorito=seletor.value; try{localStorage.setItem('clubeFavoritoBrasileirao',clubeFavorito)}catch(e){} document.getElementById('conteudo').innerHTML=meuClube(); }
    function removerMeuClube(){ clubeFavorito=''; try{localStorage.removeItem('clubeFavoritoBrasileirao')}catch(e){} document.getElementById('conteudo').innerHTML=meuClube(); }
    function meuClube(){ const clube=clubePorNome[clubeFavorito]; return `<h2>Meu clube</h2><section class="meu-clube-painel"><p>Escolha seu clube para deixar o portal personalizado. Sua seleção fica salva neste navegador e você pode abrir rapidamente as notícias e a escalação da equipe.</p><div class="meu-clube-controles"><select id="seletor-meu-clube" aria-label="Escolha seu clube"><option value="">Selecione um clube</option>${clubes.map(c=>`<option value="${c[0]}" ${c[0]===clubeFavorito?'selected':''}>${c[0]}</option>`).join('')}</select><button class="botao-clube" onclick="salvarMeuClube()">Salvar clube</button>${clubeFavorito?'<button class="botao-clube secundario" onclick="removerMeuClube()">Remover</button>':''}</div>${clube?`<div class="meu-clube-salvo">${escudo(clube)}<div><strong>${clubeFavorito} é o seu clube</strong><span>Acompanhe notícias, elenco e escalação em um só lugar.</span></div><button class="botao-clube" onclick="mostrarNoticiasDoClube('${clubeFavorito}')">Ver clube</button></div>`:''}</section>`; }
    const noticiasPrincipais={
      'Athletico-PR':['Athletico x Fluminense bate recorde de público na Arena da Baixada no Brasileirão','O confronto movimentou a torcida rubro-negra e registrou uma marca expressiva de público na competição.'],
      'Atlético-MG':['Escalação do Atlético-MG: Ruan e Everson seguem como dúvidas para o clássico','A comissão técnica acompanha a situação da dupla antes de definir o time para o próximo confronto.'],
      'Bahia':['Segue o BAba: rodada da Série A deixa o Bahia no G-5 e o Vitória ameaçado pelo Z-4','A rodada altera o cenário dos clubes baianos na classificação do Brasileirão.'],
      'Botafogo':['Análise: Botafogo não aproveita momento, peca nas finalizações e aumenta seca contra o Flamengo','O Glorioso criou oportunidades, mas não conseguiu transformar o volume de jogo em resultado.'],
      'Bragantino':['“Pior jogo do campeonato”, diz Mancini após derrota do Bragantino para o São Paulo','O técnico avaliou a atuação da equipe após o resultado negativo na rodada.'],
      'Chapecoense':['Análise: chances desperdiçadas custam caro para a Chapecoense','A Chape teve oportunidades no jogo, mas não conseguiu aproveitar os melhores momentos.'],
      'Corinthians':['Análise: Corinthians esbarra nas próprias limitações em clássico e não evolui após semana livre','O Timão não conseguiu converter a preparação em melhora de desempenho no confronto.'],
      'Coritiba':['Coritiba enfrenta o Remo em busca do G-7 do Brasileirão','O Coxa mira um resultado importante para se aproximar da parte alta da tabela.'],
      'Cruzeiro':['Escalação do Cruzeiro: Artur Jorge tem chance de repetir o time, mas leva dúvida para clássico','O treinador pode manter a base da equipe, embora ainda avalie uma mudança para a partida.'],
      'Flamengo':['Joaquín Freitas desembarca no Rio de Janeiro para assinar com o Flamengo','O jogador chega à cidade para concluir os últimos detalhes antes de oficializar o vínculo.'],
      'Fluminense':['Hulk supera fase de adaptação no Fluminense e tem uma participação em gol por jogo com Marcão','O atacante vive bom momento e ganha protagonismo no time tricolor.'],
      'Grêmio':['Com dois gols de Gustavo Martins, Grêmio bate a Chapecoense','O Tricolor gaúcho conquistou um resultado importante com destaque para o defensor.'],
      'Internacional':['Inter é derrotado pelo Bahia em jogo de cinco gols e vai pressionado para o Gre-Nal decisivo de quinta','O Colorado busca resposta rápida antes do clássico que pode mudar o ambiente da equipe.'],
      'Mirassol':['Análise: Mirassol joga melhor que o líder Palmeiras, mas deixa vitória escapar','A equipe criou as melhores ações da partida, porém não conseguiu segurar o resultado.'],
      'Palmeiras':['Palmeiras perde pontos em Mirassol e vê Flamengo se aproximar na briga pela liderança','O empate fora de casa reduz a distância para o vice-líder na tabela do Brasileirão.'],
      'Remo':['Remo enfrentará o Coritiba em jogo decisivo para deixar o Z-4','O Leão Azul entra em campo precisando pontuar para ganhar fôlego na luta contra o rebaixamento.'],
      'Santos':['Santos anuncia Arthur e começa preparação para o clássico de quarta-feira','O Peixe apresentou o reforço e iniciou os trabalhos para o próximo compromisso.'],
      'São Paulo':['Cotia resolve? Como Dorival tem usado a base para reformular o São Paulo; veja lista dos jogadores','A comissão técnica amplia o espaço para atletas formados nas categorias de base do clube.'],
      'Vasco da Gama':['Após goleada no fim de semana, o Vasco enfrentará o Vitória em busca de classificação na semifinal da Copa do Brasil','O Cruzmaltino volta as atenções para a competição de mata-mata em um duelo decisivo.'],
      'Vitória':['Segue o BAba: rodada da Série A deixa o Bahia no G-5 e o Vitória ameaçado pelo Z-4','A rodada altera o cenário dos clubes baianos na classificação do Brasileirão.']
    };
    const temasClubes={
      'Palmeiras':['#006437','#ffffff',false],'Flamengo':['#c52613','#080808',false],'Corinthians':['#151515','#ffffff',false],'São Paulo':['#ffffff','#d82839',true],'Santos':['#ffffff','#8d97a3',true],'Grêmio':['#1683c5','#111111',false],'Internacional':['#c8222b','#ffffff',false],'Atlético-MG':['#151515','#ffffff',false],'Vasco da Gama':['#111111','#c91d32',false],'Cruzeiro':['#1f4ea5','#ffffff',false],'Bahia':['#1671c5','#dc2639',false],'Coritiba':['#087f40','#ffffff',false],'Mirassol':['#f0c419','#187d45',false],'Remo':['#185daf','#ffffff',false],'Chapecoense':['#13814a','#ffffff',false],'Fluminense':['#7c2433','#147654',false],'Athletico-PR':['#b71936','#111111',false],'Bragantino':['#e32938','#ffffff',false],'Botafogo':['#121212','#ffffff',false],'Vitória':['#d62333','#111111',false]
    };
    function mostrarNoticiasDoClube(nome){ const clube=clubePorNome[nome], conteudo=document.getElementById('conteudo'), principal=noticiasPrincipais[nome], tema=temasClubes[nome]; const itens=[['Bastidores e destaques do clube',clube[4]],['Preparação para a próxima rodada','O elenco trabalha com foco total no próximo compromisso do Brasileirão.']]; conteudo.className=`tema-clube${tema[2] ? ' tema-clube-claro' : ''}`; conteudo.style.setProperty('--cor-clube',tema[0]); conteudo.style.setProperty('--cor-secundaria',tema[1]); conteudo.innerHTML=`<div class="acoes-pagina"><button class="voltar" onclick="document.getElementById('conteudo').className='';document.getElementById('conteudo').style.cssText='';document.getElementById('conteudo').innerHTML=times()">← Voltar aos clubes</button><button class="voltar acao-principal" onclick="abrirEscalacao('${nome}')">Escalação</button></div><section class="identidade-clube" aria-label="Identidade visual do ${nome}">${escudo(clube)}<div><small>Especial ${nome}</small><strong>Universo ${nome}</strong></div></section><h2>Notícias do ${nome}</h2><article class="destaque"><img src="${midiaClubes[nome][1]}" alt="Imagem do ${nome}"><div class="destaque-conteudo"><div class="noticia-clube">${escudo(clube,true)}${nome}</div><h3>${principal[0]}</h3><small>Notícia principal · 25ª rodada</small><p>${principal[1]}</p></div></article><div class="titulo-secao" style="margin-top:25px">Mais do clube</div>${itens.map(i=>`<article class="card noticia-card"><img src="${midiaClubes[nome][1]}" alt="Imagem do ${nome}"><div class="info"><div class="noticia-clube">${escudo(clube,true)}${nome}</div><h3>${i[0]}</h3><small>Atualizado recentemente</small><p>${i[1]}</p></div></article>`).join('')}`; window.scrollTo({top:0,behavior:'smooth'}); }
